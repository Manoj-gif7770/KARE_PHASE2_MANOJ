// no of parameters in method overloding

import java.util.*;
class Main{
    void add(int a,int b)
    {
        System.out.println(a+b);
    }
    void add(int a,int b,int c)
    {
        System.out.println(a+b+c);
    }
    
    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        int a = obj.nextInt();
        int b = obj.nextInt();
        int c = obj.nextInt();
        Main m = new Main();
        m.add(a,b);
        m.add(a,b,c);
        
    }
}
//output:
2
6
9
8
17

// Types of parameter
import java.util.*;
class Main{
    void print(int a,float b)
    {
        System.out.println(a+" "+b);
    }
    void print(float b,char c)
    {
        System.out.println(b+" "+c);
    }
    
    public static void main (String[] args) {
        Scanner obj=new Scanner(System.in);
        int a = obj.nextInt();
        float b = obj.nextFloat();
        char c = obj.next().charAt(0);
        Main m = new Main();
        m.print(a,b);
        m.print(b,c);
        
    }
}
// output:
20
50
90
20 50.0
50.0 9

// Order of parameters

import java.util.*;
class Main {
    void print(float b, int a) {
        System.out.println(b + " " + a);
    }
    void print(char c, float b) {
        System.out.println(c + " " + b);
    }
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);
        int a = obj.nextInt();
        float b = obj.nextFloat();
        char c = obj.next().charAt(0);
        Main m = new Main();
        m.print(b, a);
        m.print(c, b);
    }
}

//output:
22
56
22
56.0 22
2 56.0
